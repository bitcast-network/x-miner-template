# Existing registered Bittensor wallet. The app never creates or copies keys.
BITCAST_X_NETWORK=finney
BITCAST_X_NETUID=93
BITCAST_X_MECHANISM_ID=1
BITCAST_X_WALLET_NAME=default
BITCAST_X_WALLET_HOTKEY=default
BITCAST_X_WALLET_PATH=/home/miner/.bittensor/wallets

# Public endpoint advertised on-chain and durable miner state.
BITCAST_X_HOST=0.0.0.0
BITCAST_X_PORT=8095
BITCAST_X_PUBLIC_IP=203.0.113.10
BITCAST_X_STATE_DIR=/var/lib/bitcast-x

# Replace with the protocol's published feed and qualification configuration.
BITCAST_X_CAMPAIGN_FEED_URL=https://bitcast-api.bitcast.network/api/v2/public/x/campaign-manifest-v4
BITCAST_X_QUALIFICATION_OWNER_HOTKEY=5DAoDtMxVqtMu2Nd5E7QhPEGXDMgrySvE1b3rRT5ARDhfNNK
BITCAST_X_QUALIFICATION_MINIMUM_ALPHA=15000
BITCAST_X_QUALIFICATION_EFFECTIVE_BLOCK=0
# The full immutable public history takes precedence over the single-entry fallback above.
BITCAST_X_QUALIFICATION_SCHEDULE_JSON={"configurations":[{"version":1,"owner_hotkey":"5DAoDtMxVqtMu2Nd5E7QhPEGXDMgrySvE1b3rRT5ARDhfNNK","minimum_conviction_alpha":"15000","effective_block":0},{"version":2,"owner_hotkey":"5DAoDtMxVqtMu2Nd5E7QhPEGXDMgrySvE1b3rRT5ARDhfNNK","minimum_conviction_alpha":"15000","minimum_self_stake_alpha":"15000","effective_block":8972000}]}

BITCAST_X_LOG_LEVEL=INFO
BITCAST_X_LOG_FORMAT=json
X_MINER_FORCE_COMMIT_TIMEOUT_SECONDS=180
X_MINER_RESULTS_API_URL=https://bitcast-api.bitcast.network
X_MINER_RESULTS_POLL_SECONDS=30
# Generate independently per environment, for example: openssl rand -hex 32
X_MINER_INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters
