# The reference product talks to a separately deployed Bitcast X miner node.
X_MINER_NODE_URL=http://127.0.0.1:8095
# Same 64-character application token configured on that node. Never expose it to browser code.
X_MINER_NODE_TOKEN=replace-with-the-node-application-token-before-running-this-service

X_MINER_HOST=0.0.0.0
X_MINER_PORT=8080
X_MINER_REQUEST_TIMEOUT_SECONDS=30
# Claim creation may wait for an on-chain batch, so it has a separate longer deadline.
X_MINER_CLAIM_TIMEOUT_SECONDS=120

# Optional strict draft precheck. When configured, all three OpenRouter evaluations must approve
# the draft before this product forwards a claim to the miner node. Without a key, claims continue
# normally and the UI displays a light warning that precheck is disabled.
# X_MINER_OPENROUTER_API_KEY=replace-with-an-openrouter-api-key
X_MINER_OPENROUTER_MODEL=qwen/qwen3-32b:nitro
X_MINER_OPENROUTER_TIMEOUT_SECONDS=90

# Optional HTTP Basic protection for a hosted demo. Production products should replace this with
# their normal creator authentication. Leave both unset only behind another authenticated gateway.
X_MINER_WEB_USERNAME=bitcast
X_MINER_WEB_PASSWORD=replace-with-a-strong-demo-password
