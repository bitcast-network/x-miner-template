# Existing registered Bittensor wallet. The app never creates or copies keys.
BITCAST_X_NETWORK=finney
BITCAST_X_NETUID=93
BITCAST_X_MECHANISM_ID=1
BITCAST_X_WALLET_NAME=default
BITCAST_X_WALLET_HOTKEY=default
BITCAST_X_WALLET_PATH=/home/miner/.bittensor/wallets

# Public endpoint advertised on-chain and durable miner state.
BITCAST_X_HOST=0.0.0.0
BITCAST_X_PORT=8095
BITCAST_X_PUBLIC_IP=203.0.113.10
BITCAST_X_STATE_DIR=/var/lib/bitcast-x

# Replace with the protocol's published feed and qualification configuration.
BITCAST_X_CAMPAIGN_FEED_URL=https://bitcast-api.bitcast.network/api/v2/public/x/campaign-manifest
BITCAST_X_QUALIFICATION_OWNER_HOTKEY=5ReplaceWithPublishedOwnerHotkey
BITCAST_X_QUALIFICATION_MINIMUM_ALPHA=0
BITCAST_X_QUALIFICATION_EFFECTIVE_BLOCK=0

BITCAST_X_LOG_LEVEL=INFO
BITCAST_X_LOG_FORMAT=json
X_MINER_FORCE_COMMIT_TIMEOUT_SECONDS=30
